DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peluqueria?schema=public"
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000

# Emails con acceso al panel de administración (separados por comas).
# Si está vacío, nadie puede entrar en /admin.
ADMIN_EMAILS=""

# Orígenes adicionales permitidos por CORS, separados por comas (por ejemplo,
# un dominio propio o un preview de Vercel). El dominio de producción y
# localhost:5173 ya están permitidos por defecto en el código.
CORS_ORIGIN=""
